{
  "version": 2,
  "name": "next-k-frontend",
  "buildCommand": null,
  "outputDirectory": ".",
  "redirects": [
    { "source": "/wangge", "destination": "/grid.html", "permanent": true },
    { "source": "/wangge.html", "destination": "/grid.html", "permanent": true },
    { "source": "/trading-os", "destination": "/trading-os.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
